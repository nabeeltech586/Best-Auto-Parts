# ============================================================
# REQUIRED — the app won't start without these.
# ============================================================

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase service-role key. Bypasses RLS; used only by server-side routes.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# WhatsApp token encryption (64 hex chars = 32 bytes, AES-256-GCM).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-64-character-hex-encryption-key

# Meta App Secret (Meta for Developers → App Settings → Basic).
META_APP_SECRET=your-meta-app-secret

# ============================================================
# RECOMMENDED
# ============================================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_LOCALE=en

# ============================================================
# OPTIONAL
# ============================================================
# META_APP_ID=your-meta-app-id
# AUTOMATION_CRON_SECRET=generate-a-long-random-string

# ============================================================
# PhonePe Payment Gateway (Track 2: PG V1 Standard Checkout)
# ============================================================
PHONEPE_MERCHANT_ID=PGTESTPAYUAT
PHONEPE_SALT_KEY=099eb0cd-02cf-4e2a-8aca-3e6c6aff0399
PHONEPE_SALT_INDEX=1
PHONEPE_HOST_URL=https://api-preprod.phonepe.com/apis/pg-sandbox
NEXT_PUBLIC_APP_URL=https://best-auto-parts-one.vercel.app
